# Copy to .env and fill in. .env is gitignored and must stay that way.

# --- Required: structured-output agents (query, analysis, viz) ---
OPENAI_API_KEY=

# --- Optional: narrator agent ---
# If unset, the narrator falls back to the OpenAI model. Everything still runs.
GROQ_API_KEY=

# --- Per-agent model overrides (provider:model) ---
# Defaults shown. The three structured agents need a model with reliable strict
# JSON schema support; the narrator is prose-only so a Groq model is fine there.
QUERY_MODEL=openai:gpt-5.4-mini
ANALYSIS_MODEL=openai:gpt-5.4-mini
VIZ_MODEL=openai:gpt-5.4-mini
NARRATOR_MODEL=groq:openai/gpt-oss-120b

# --- Optional: LangSmith tracing ---
# Leave LANGCHAIN_API_KEY blank to run with tracing off. Nothing else changes.
# Auto-instrumentation only - the graph nodes show up as spans on their own.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=agentic-analyst

# --- Optional: Google Drive MCP server (alternative report sink) ---
# Leave DRIVE_MCP_COMMAND blank (the default) and approved reports are written to
# outputs/. That is the supported path and needs no Google credentials at all.
#
# To send reports to Drive instead, point these at an MCP server that can WRITE.
# Both servers I evaluated turned out to be read-only - they expose search and read
# but no create/upload tool, so they cannot fulfil the sink's contract:
#   @modelcontextprotocol/server-gdrive  (archived 2025-01-14, read-only)
#   mcp-google-drive                     (read-only in practice)
# The sink discovers tools at runtime and matches a create/upload tool by name, so
# any write-capable server works here without a code change. If it can't find one,
# it logs the reason and falls back to local - the run still succeeds.
DRIVE_MCP_COMMAND=
DRIVE_MCP_ARGS=
DRIVE_MCP_FOLDER_ID=1NjoiZ1MhT73dhYQBN6-N3h5u-LKrZKvE

# Passed through to the MCP server process, if it needs them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
